# Marketo REST API credentials — from a custom service (Admin > LaunchPoint).
# The service's API-only user needs Read-Only/Read-Write Assets and Lead
# permissions (folder browsing, program membership, lead create/update).
MARKETO_MUNCHKIN_ID=123-ABC-456
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=

# Optional: a default Marketo program to load on startup (Program Id, not
# name). You can skip this entirely and always pick a program from the
# in-app event picker instead.
MARKETO_PROGRAM_ID=

# Program Member status values to write back after the event. These must
# exactly match the status values defined on your program's channel
# (Admin > Tags/Channels in Marketo) — most "Event" channels ship with
# "Attended" and "No Show" out of the box, but check yours.
MARKETO_ATTENDED_STATUS=Attended
MARKETO_NO_SHOW_STATUS=No Show

# Optional: enables the in-app event picker. Set this to the exact name of
# a Marketo Design Studio folder that contains (or leads down to) your
# event programs, e.g. "Events" — the picker will look for the most recent
# "YYYY" and "QN"-style subfolder names as it descends, falling back to
# just listing whatever programs are directly inside if it doesn't find
# any. Unlike programs and smart campaigns, folders don't have an id
# visible anywhere in the Marketo UI, so this is matched by name instead —
# copy it exactly as it appears in Design Studio. Leave unset to skip
# auto-discovery — the event picker will offer a manual "enter a Program
# Id" field instead.
MARKETO_EVENTS_ROOT_FOLDER_NAME=

# Optional: require this password to use the app. Enough to keep casual
# passersby off a shared laptop or an ngrok link at an event — not real
# security against a determined attacker (sessions live in server memory
# and are lost on restart; there's no rate limiting or hashing). Leave
# unset to disable the login screen entirely.
APP_PASSWORD=

PORT=4000
